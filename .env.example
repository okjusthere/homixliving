# Supabase Postgres transaction pooler
DATABASE_URL=

# Auth.js / Google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Homix Web public-profile sync (same secret on both Vercel projects)
HOMIXWEB_REVALIDATE_URL=https://www.homixny.com/api/revalidate-agents
AGENTS_REVALIDATE_SECRET=

# Email
RESEND_API_KEY=
FROM_EMAIL=invoice@homixny.com
CC_EMAIL=homix@homixny.com
APP_BASE_URL=https://agents.homixny.com

# OneKey broker-only market tools. Keep this key server-side and scope it to
# broker:read in BBO; never use the public Homix Web listings key here.
BBO_API_URL=https://onekey.kevv.ai
BBO_BROKER_API_KEY=

# Scheduled routes
CRON_SECRET=

# Private Cloudflare R2 deal documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=homix-deal-documents
# Optional for isolated local S3-compatible storage; rejected in production.
# R2_LOCAL_ENDPOINT=http://127.0.0.1:4569

# Cloudflare Stream
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LICENSE_TRANSFER_FEE=
APP_URL=https://agents.homixny.com

# Documenso integration through the dedicated eSign bridge. Server-only credentials.
# Package versions and the verified company signer are configured in /admin/signing.
# Confirmed countersigner for BOTH companies: Si Zhang <hr@homixny.com>.
ESIGN_BRIDGE_BASE_URL=
ESIGN_BRIDGE_API_KEY=
ESIGN_PORTAL_CALLBACK_SECRET=

# Roll out with 0 first. Change to 1 only after the eSign template and Stripe
# products have passed an end-to-end onboarding smoke test in production.
ONBOARDING_V2_ENFORCED=0

# Content center: private bucket; existing R2 account/access credentials above.
R2_CONTENT_BUCKET_NAME=homixliving-content
# Dedicated credentials scoped only to the private content bucket.
R2_CONTENT_ACCESS_KEY_ID=
R2_CONTENT_SECRET_ACCESS_KEY=
# Dedicated to the Cloudflare scheduled recovery worker, not other Portal cron routes.
CONTENT_RECOVERY_SECRET=
AZURE_IMAGE_ENDPOINT=https://kevvrealtime-resource.services.ai.azure.com/openai/v1
AZURE_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_API_VERSION=
CONTENT_REFERENCE_ORIGINS=https://www.homixny.com,https://homixny.com,https://onekeymls.kevv.ai

# Native email workspace backed by the existing marketing service.
EMAIL_SERVICE_URL=https://marketing.homixny.com
EMAIL_SERVICE_HOMIX_SECRET=

# Content Studio highlight extraction; independent of Email Service.
AZURE_TEXT_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_TEXT_DEPLOYMENT=
AZURE_TEXT_API_KEY=
