# Supabase Postgres transaction pooler
DATABASE_URL=

# Auth.js / Google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=

# Homix Web public-profile sync (same secret on both Vercel projects)
HOMIXWEB_REVALIDATE_URL=https://www.homixny.com/api/revalidate-agents
AGENTS_REVALIDATE_SECRET=

# Email
RESEND_API_KEY=
FROM_EMAIL=invoice@homixny.com
CC_EMAIL=homix@homixny.com
APP_BASE_URL=https://agents.homixny.com

# OneKey broker-only market tools. Keep this key server-side and scope it to
# broker:read in BBO; never use the public Homix Web listings key here.
BBO_API_URL=https://onekey.kevv.ai
BBO_BROKER_API_KEY=

# Scheduled routes
CRON_SECRET=

# Private Cloudflare R2 deal documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=homix-deal-documents

# Cloudflare Stream
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=https://agents.homixny.com

# Agent onboarding eSign integration. Use a dedicated application key with only
# templates:read, transactions:write, and envelopes:read/write/send permissions.
ESIGN_API_URL=
ESIGN_APPLICATION_KEY=
ESIGN_ONBOARDING_HOMIX_REALTY_TEMPLATE_ID=
ESIGN_ONBOARDING_HOMIX_REALTY_TEMPLATE_VERSION_ID=
ESIGN_ONBOARDING_HOMIX_REALTY_TEMPLATE_SCHEMA_HASH=
ESIGN_ONBOARDING_HOMIX_REALTY_COUNTERSIGNER_NAME=
ESIGN_ONBOARDING_HOMIX_REALTY_COUNTERSIGNER_EMAIL=
ESIGN_ONBOARDING_HOMIX_LIVING_TEMPLATE_ID=
ESIGN_ONBOARDING_HOMIX_LIVING_TEMPLATE_VERSION_ID=
ESIGN_ONBOARDING_HOMIX_LIVING_TEMPLATE_SCHEMA_HASH=
ESIGN_ONBOARDING_HOMIX_LIVING_COUNTERSIGNER_NAME=
ESIGN_ONBOARDING_HOMIX_LIVING_COUNTERSIGNER_EMAIL=

# Roll out with 0 first. Change to 1 only after the eSign template and Stripe
# products have passed an end-to-end onboarding smoke test in production.
ONBOARDING_V2_ENFORCED=0
